@using EB.Features.Shared.Resources
@using EB.Features.Site.Shared.ViewModels.Components
@helper Render(SingleSelectionViewModel model, bool showLabel)
{
    <div class="form-group">
        @if (showLabel)
        {
            <label>@AppResources.Conjunction</label>
        }
        <select id="dropdown-conjunction">
            @foreach (var group in model.Items)
            {
                <option value="@group.Value" @(group.Selected ? " selected=\"selected\"" : string.Empty)>@group.Text</option>
            }
        </select>
        <input type="hidden" name="UserSelectedConjunctionId" id="UserSelectedConjunctionId" value="@model.UserSelectedId" />
    </div>
}