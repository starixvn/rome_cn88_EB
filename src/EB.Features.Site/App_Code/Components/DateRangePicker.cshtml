@using EB.Features.Shared.Resources
@using EB.Features.Shared.Extensions
@using EB.Features.Shared.Utilities
@using EB.Features.Site.Shared.ViewModels.Components

@helper Render(DateRangePickerViewModel model)
{
    <div id="daterange-picker"
         class="daterange-picker"
         data-dayrange="@model.DayRange"
         data-currentdate="@SystemTime.Today"
         data-mindate="@model.MinDate.ToShortDate()"
         data-maxdate="@model.MaxDate.ToShortDate()">
        < />
    </div>

    <div class="form-group from-date-box">
        <label>@AppResources.From</label>
        <div class="control date">
            <div id="from-date-container"
                 class="input-group date fromdate">
                <input type="text"
                       id="from-date"
                       name="FromDate"
                       readonly="readonly"
                       autocomplete="off"
                       class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                       value="@model.FromDate.ToShortDate()" />
                <span class="input-group-addon">
                    <span class="icon-calendar" id="fdate_trigger"></span>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group to-date-box">
        <label>@AppResources.To</label>
        <div class="control date">
            <div id="to-date-container"
                 class="input-group date todate">
                <input type="text"
                       id="to-date"
                       name="ToDate"
                       readonly="readonly"
                       autocomplete="off"
                       class="ui_nexdatepicker_datetextbox ui_nexdatepicker_todate form-control"
                       value="@model.ToDate.ToShortDate()" />
                <span class="input-group-addon">
                    <span class="icon-calendar" id="tdate_trigger"></span>
                </span>
            </div>
        </div>
    </div>
}