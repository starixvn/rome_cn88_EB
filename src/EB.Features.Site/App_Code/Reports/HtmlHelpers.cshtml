@using EB.Features.Shared.Extensions
@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}

@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}

@helper RenderHeaderNumberCell(decimal cellValue, string cellClass = "", bool isHiddenOnMobile = false)
{

    var value = cellValue.Round();
    <th class="text-right @(value < 0 ? "negative-value" : string.Empty) @cellClass" data-stack-column="@(isHiddenOnMobile.ToString().ToLowerInvariant())">
        @FormatNumber(value)
    </th>
}

@helper RenderHeaderNumberCell(int divisor, decimal cellValue, string cellClass = "", bool isHiddenOnMobile = false)
{

    var value = (cellValue / divisor).Round();

    <th class="text-right @(value < 0 ? "negative-value" : string.Empty) @cellClass" data-stack-column="@(isHiddenOnMobile.ToString().ToLowerInvariant())">
        @FormatNumber(value)
    </th>
}

@helper RenderHeaderNumberCell(int cellValue, string cellClass = "")
