@using EB.Features.Main.Resources
@using EB.Features.Site.Shared
@using EB.Features.Site.Shared.Models
@using EB.Features.Site.Login

@model LoginViewModel
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.png" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link href="~/assets/login/bundles/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <img class="login-panel" src="~/assets/login/styles/images/Login_panel.svg" />
        <div id="mainholder" class="block-login">
            <form id="formLogin" class="form-login" method="POST" autocomplete="off">
                <div class="box-lang">
                    <div class="dropdown">
                        <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <span class="flag" id="flag"></span>
                            <span id="lblLanguage">@Model.LanguageName</span>
                            <span class="caret"></span>
                            <input type="hidden" value="@Model.LanguageCode" id="HideLanguage" name="HideLanguage">
                        </span>
                        <ul class="dropdown-menu" aria-labelledby="langList" id="language-ddl">
                            <li><a href="#"><span class="flag flag-cn" data-language-code="zh-Hans" data-flag="flag-cn"></span>简体</a></li>
                            <li><a href="#"><span class="flag flag-tw" data-language-code="zh-TW" data-flag="flag-tw"></span>繁體</a></li>
                            <li><a href="#"><span class="flag flag-en" data-language-code="en-US" data-flag="flag-en"></span>English</a></li>
                        </ul>
                    </div>
                </div>
                <h1 class="title login-text">@MainResource.Login</h1>
                <div class="rowlg msg-error" id="divMessage">@Model.ErrorMessage</div>
                <div class="rowlg">
                    <input type="text" class="txt" placeholder="Username" id="username" name="username" tabindex="1" />
                    <i class="icon-user"></i>
                </div>
                <div class="rowlg">
                    <input type="password" class="txt" placeholder="Password" id="password" name="password" tabindex="2" autocomplete="off" />
                    <i class="icon-lock"></i>
                </div>

                <div class="rowlg checkbox">
                    <label>
                        <input name="chb-showpass" type="checkbox" id="chbShowPass" tabindex="3" />
                        <span id="lbShowPass">Show password</span>
                    </label>
                </div>
                <input type="hidden" name="browserSize" id="browserSize" value="" />
                @Html.Hidden("ModelLanguage", Model.LanguageCode)
                @Html.Hidden("ModelErrMsg", Html.Raw(Model.ErrorMessage))
                <div class="list-button">
                    <input type="submit" class="btnLogin" value="@MainResource.Login" id="btnLogin" tabindex="5" />
                </div>
                <input name="code" id="code" type="hidden" value="" />
            </form>
        </div>
    </div>
    
    @Html.Hidden("changeLanguagePath", HttpContext.Current.Response.ApplyAppPathModifier("~/Language/Change"))
    @Html.Hidden("currentLanguage", UserSessionImpl.Current.Language)
    
    @StaticResources.RenderScripts("~/assets/login/bundles/login")
    <script type="text/javascript">
        var _page = {
            errMsg: '',
            language: ''
        };

        _page.errMsg = document.getElementById("ModelErrMsg").value;
        _page.language = document.getElementById("ModelLanguage").value;
    </script>
</body>
</html>
