@model ChangePasswordViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    <title> @MainResource.ChangePassword</title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->

    @StaticResources.RenderStyles("~/assets/common/bundles/common/common")
    @StaticResources.RenderStyles("~/assets/main/bundles/password/change-password")
</head>

<body>
    <div class="block">
        @using (Html.BeginForm("SavePassword", "UserInfo", FormMethod.Post, new { id = "formPassword", @class = "form-security form-validation", novalidate = "novalidate" }))
        {
            <div class="rules">
                <p><span class="star">*</span>@MainResource.PasswordHint01</p>
            </div>
            <div id="message-container">
                @if (Model.Result != null)
                {
                    <div class="msg @(Model.Result.IsSuccess ? "msg-success" : "msg-error")">@Model.Result.Message</div>
                }
            </div>
            <div class="rowlg">
                <label class="lb-title" for="currentPassword">@MainResource.OldPassword</label>
                <input type="password" autocomplete="off" class="txt" name="CurrentPassword" id="currentPassword" maxlength="16" />
            </div>
            <div class="rowlg">
                <label class="lb-title" for="newPassword">@MainResource.NewPassword</label>
                <input type="password" autocomplete="off" class="txt" name="NewPassword" id="newPassword" maxlength="16" />
            </div>
            <div class="rowlg">
                <label class="lb-title" for="confirmPassword">@MainResource.ConfirmPassword</label>
                <input type="password" autocomplete="off" class="txt" name="ConfirmPassword" id="confirmPassword" maxlength="16" />
            </div>
            <div class="list-button">
                <input type="button" class="btn-cancel" id="buttonCancel" value="@MainResource.Cancel" />
                <input type="submit" class="btn-submit" value="@MainResource.Save" />
            </div>
        }
    </div>
    @Html.Hidden("please-enter-oldPassword", MainResource.RequiredInputOldPwdError)
    @Html.Hidden("password-cannot-empty", MainResource.RequiredPasswordError)
    @Html.Hidden("not-correct-confirm-password", MainResource.CorrectConfirmPasswordMessage)
    @Html.Hidden("newPassword-must-be-diff-old", MainResource.NewPasswordAndOldTheSameMessage)

    @StaticResources.RenderScripts("~/assets/common/bundles/common/common")
    @StaticResources.RenderScripts("~/assets/main/bundles/password/change-password")
</body>

</html>