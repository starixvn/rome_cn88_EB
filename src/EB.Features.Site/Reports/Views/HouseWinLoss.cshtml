@using EB.Features.Shared.Extensions;
@using EB.Features.Shared.Constants;
@using EB.Features.Site.Reports.ViewModel.HouseWinLoss
@using EB.Features.Reports;
@using EB.Features.Reports.Extension;
@using EB.Features.Shared.Model;

@model HouseWinLossReportViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = ReportResources.WagerReportTitle;
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/report/bundles/reports")
}
<div class="report-detail wager-report">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@ViewBag.Title</li>
        </ul>
        @Breadcrumb.Render(Model.BreadcrumbLevelViewModel, Request.Url.Query)
    </div>
    <form class="form-inline filter report-form" role="form" id="report-form">
        @ViewerSelection.Render(Model.ReportFilterViewModel.ViewerSelectionViewModel, true)
        <div id="ticketStatusContainer" style="display:@(Model.Query.IsHistoricReport?"none":"inline-block")">
            @TicketStatusSelection.Render(Model.ReportFilterViewModel.TicketStatusSelectionViewModel, true)
        </div>
        @SportGroupMultiSelection.Render(Model.ReportFilterViewModel.SportGroupMultiSelectionViewModel)
        <div id="dateRangeContainer" style="display:none">
            @DateRangePicker.Render(Model.ReportFilterViewModel.DateRangePickerViewModel)
        </div>
        @RenderDatePicker()
        @BetTypeSelection.Render(Model.ReportFilterViewModel.BetTypeSelectionViewModel, true)
        @LiveStatusSelection.Render(Model.ReportFilterViewModel.LiveStatusSelectionViewModel, true)
        <div class="form-group">
            <label class="isTest">
                @Html.CheckBox("IsTest", Model.ReportFilterViewModel.IsTest)
                @ReportResources.ExcludeTestData
            </label>
        </div>
        <div class="form-group">
            <input type="submit" value="@AppResources.Submit" class="btn-submit" />
        </div>
        <div class="form-group note">
            <div id="GroupViewHistory" class="">
                <div>
                    @ReportResources.NoteViewHistory
                    <span id="ViewHistoryReport" class="history">
                        <span class="txt-history">@ReportResources.ViewHistoryReport</span>
                    </span>
                </div>
            </div>
            <div id="GroupBackToCurrent" class="" style="display: none">
                <div>
                    @HouseWinLossReportViewModel.NoteMaxDateDescription
                    <span id="BackToCurrentReport" class="history">
                        <span class="txt-history">@ReportResources.BackToCurrentReport</span>
                    </span>
                    <span id="icon-information" class="icon-info"></span>
                </div>
            </div>
        </div>
        @Html.Hidden("LoadLegendURL", Url.Action("LegendHouseWinLoss", "Reports"))
        <input type="hidden" name="FromDate" id="fromDate" />
        <input type="hidden" name="ToDate" id="toDate" />
        <input type="hidden" name="IsHistoricReport" id="IsHistoricReport" value="@Model.Query.IsHistoricReport.ToString()" />
        <input type="hidden" name="RoleId" id="RoleId" value="@Model.Query.RoleId" />
    </form>
    <form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("ExportHouseWinLoss","Reports")">
        @Html.Hidden("UserSelectedViewer", Model.Query.UserSelectedViewer)
        @Html.Hidden("RoleId", Model.Query.RoleId)
        @Html.Hidden("Date", Model.Query.Date)
        @Html.Hidden("FromDate", Model.Query.FromDate)
        @Html.Hidden("ToDate", Model.Query.ToDate)
        @Html.Hidden("IsHistoricReport", Model.Query.IsHistoricReport.ToString())
        @Html.Hidden("UserSelectedSportGroupIds", Model.Query.UserSelectedSportGroupIds)
        @Html.Hidden("UserSelectedBetTypeId", Model.Query.UserSelectedBetTypeId)
        @Html.Hidden("UserSelectedLiveStatusId", Model.Query.UserSelectedLiveStatusId)
        @Html.Hidden("UserSelectedTicketStatusId", Model.Query.UserSelectedTicketStatusId)
        @Html.Hidden("IsTest", Model.ReportFilterViewModel.IsTest)
        @Html.Hidden("CustId", Model.Query.CustId)
    </form>

    @if (Model.Query.Role.IsHeadline())
    {
        @Html.Partial("~/Reports/Views/HouseWinLoss/HeadlineTable.cshtml", Model);
    }
    else if (Model.Query.Role.IsSuperLevel())
    {
        @Html.Partial("~/Reports/Views/HouseWinLoss/SuperTable.cshtml", Model);
    }
    else if (Model.Query.Role.IsMasterLevel())
    {
        @Html.Partial("~/Reports/Views/HouseWinLoss/MasterTable.cshtml", Model);
    }
    else if (Model.Query.Role.IsAgentLevel())
    {
        @Html.Partial("~/Reports/Views/HouseWinLoss/AgentTable.cshtml", Model);
    }
    else
    {
        @Html.Partial("~/Reports/Views/HouseWinLoss/MemberTable.cshtml", Model);
    }

</div>

@section Scripts{
    @StaticResources.RenderScripts("~/assets/report/bundles/housewinloss")
    <script>
        var allBetTypeText = '@AppResources.AllBetTypes';
        var betTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReportFilterViewModel.AllBetTypesSelectionViewModel.Items));
    </script>
}
@helper RenderDatePicker()
{
    <div class="form-group date-box" style="display:@(Model.Query.IsHistoricReport?"none":"inline-block")">
        <label>@ReportResources.Date</label>
        <div class="control date">
            <div id="date-container"
                 class="input-group date fromdate"
                 data-mindate="@Model.ReportFilterViewModel.DatePickerViewModel.MinDate.ToShortDate()"
                 data-maxdate="@Model.ReportFilterViewModel.DatePickerViewModel.MaxDate.ToShortDate()"
                 data-currentdate="@Model.ReportFilterViewModel.DatePickerViewModel.CurrentDate.ToShortDate()">
                <input type="text"
                       id="date"
                       name="Date"
                       readonly="readonly"
                       autocomplete="off"
                       class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                       value="@Model.ReportFilterViewModel.DatePickerViewModel.CurrentDate.ToShortDate()" />
                <span class="input-group-addon">
                    <span class="icon-calendar" id="fdate_trigger"></span>
                </span>
            </div>
        </div>
    </div>
}
