@using EB.Features.Shared.Extensions;
@using EB.Features.Shared.Constants;
@using EB.Features.Site.Reports.ViewModel.HouseWinLoss
@model HouseWinLossReportViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = "Wager Report";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/report/bundles/reports")
}
<div class="report-detail wager-report">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@ViewBag.Title</li>
        </ul>
        <div class="breadcrumb-container">
            <span id="icon-excel" class="icon-excel" title="@AppResources.ExportToExcel" data-toggle="tooltip" data-placement="bottom"></span>
        </div>
    </div>
    <form class="form-inline filter report-form" role="form" id="report-form">
        <div id="ticketStatusContainer" style="display:@(Model.Query.IsHistoricReport==1?"none":"inline-block")">
            @TicketStatusSelection.Render(Model.ReportFilterViewModel.TicketStatusSelectionViewModel, true)
        </div>
        @SportGroupSelection.Render(Model.ReportFilterViewModel.SportGroupSelectionViewModel, true)
        <div class="form-group js-month-group"
             id="dateRangeContainer"
             data-mindate="@Model.ReportFilterViewModel.DateRangePickerViewModel.MinDate.ToShortDate()"
             data-maxdate="@Model.ReportFilterViewModel.DateRangePickerViewModel.MaxDate.ToShortDate()"
             data-fromdate="@Model.ReportFilterViewModel.DateRangePickerViewModel.FromDate.ToShortDate()"
             data-todate="@Model.ReportFilterViewModel.DateRangePickerViewModel.ToDate.ToShortDate()">
            <label>Month</label>
            <div id="monPickr1">
            </div>
        </div>
        <div class="form-group js-month-group">
            <label>From</label>
            <div id="fromDay1">
            </div>
        </div>
        <div class="form-group js-month-group">
            <label>To</label>
            <div id="toDay1">
            </div>
        </div>
        @RenderDatePicker()
        @BetTypeSelection.Render(Model.ReportFilterViewModel.BetTypeSelectionViewModel, true)
        @LiveStatusSelection.Render(Model.ReportFilterViewModel.LiveStatusSelectionViewModel, true)
        <div class="form-group">
            <label class="isTest">
                @Html.CheckBox("IsTest", Model.ReportFilterViewModel.IsTest)
                Exclude Test Data
            </label>
        </div>
        <div class="form-group">
            <input type="submit" value="@AppResources.Submit" class="btn-submit" />
        </div>
        <div class="form-group note">
            <div id="GroupViewHistory" class="">
                <div>@ReportResources.NoteViewHistory <span id="ViewHistoryReport" class="history"><span class="txt-history">@ReportResources.ViewHistoryReport</span></span></div>
            </div>
            <div id="GroupBackToCurrent" class="" style="display: none">
                <div>@Model.NoteMaxDateDescription <span id="BackToCurrentReport" class="history"><span class="txt-history">@ReportResources.BackToCurrentReport</span></span></div>
            </div>
        </div>
        <input type="hidden" name="FromDate" id="fromDate" />
        <input type="hidden" name="ToDate" id="toDate" />
        <input type="hidden" name="IsHistoricReport" id="IsHistoricReport" value="@Model.Query.IsHistoricReport" />
    </form>
    <form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("ExportHouseWinLoss","Reports")">        
        @Html.Hidden("Date", Model.Query.Date)
        @Html.Hidden("FromDate", Model.Query.FromDate)
        @Html.Hidden("ToDate", Model.Query.ToDate)
        @Html.Hidden("IsHistoricReport", Model.Query.IsHistoricReport)
        @Html.Hidden("UserSelectedSportGroupId", Model.Query.UserSelectedSportGroupId)
        @Html.Hidden("UserSelectedBetTypeId", Model.Query.UserSelectedBetTypeId)
        @Html.Hidden("UserSelectedLiveStatusId", Model.Query.UserSelectedLiveStatusId)
        @Html.Hidden("UserSelectedTicketStatusId", Model.Query.UserSelectedTicketStatusId)
        @Html.Hidden("IsTest", Model.ReportFilterViewModel.IsTest)
    </form>
    <div class="tab-content main-content" id="tab-main-content">
        <table class="tbl-noborder tbl-report settlement-report" id="tbl-report">
            <thead class="tableFloatingHeaderOriginal">
                <tr>
                    <th class="text-left header bettype"> Headline</th>
                    <th class="text-right header"> Wagers</th>
                    <th class="text-right header"> Stake</th>
                    <th class="text-right header"> Valid Stake</th>
                    <th class="text-right header"> Member Income</th>
                    <th class="text-right header"> SMA Comm</th>
                    <th class="text-right header"> House WL</th>
                    <th class="text-right header"> House Comm</th>
                    <th class="text-right header"> House Income</th>
                    <th class="text-right header"> Headline Stock</th>
                    <th class="text-right header"> Headline Stock %</th>
                </tr>
            </thead>
            @foreach (var row in Model.ReportData.Matches)
            {
                <tr>
                    <td class="text-left">
                        <a href="javascript:void(0);" class="lnk-internal"
                           data-cust-id="@row.CustId"
                           data-cust-name="@row.UserName"
                           data-role-id="0">@row.UserName</a>
                    </td>
                    @HtmlHelpers.RenderWagerCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(row.Stake)
                    @HtmlHelpers.RenderNumberCell(row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome )
                    @HtmlHelpers.RenderNumberCell(row.SuperComm )
                    @HtmlHelpers.RenderNumberCell(row.HouseWinLoss )
                    @HtmlHelpers.RenderNumberCell(row.HouseComm )
                    @HtmlHelpers.RenderNumberCell(row.HouseIncome )
                    @HtmlHelpers.RenderNumberCell(row.HeadlineStock )
                    @HtmlHelpers.RenderStockPercentCell(row.HeadlineStock, Model.ReportData.Total.HeadlineStock )
                </tr>
            }
            @if (Model.ReportData.IsShowTotalRow)
            {
                <tfoot>
                    <tr class="total">
                        <th class="text-right header"></th>
                        @HtmlHelpers.RenderWagerCell(Model.ReportData.Total.Wagers )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.Stake )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.ValidStake )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.MemberIncome )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.SuperComm )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.HouseWinLoss )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.HouseComm )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.HouseIncome )
                        @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.HeadlineStock )
                        @HtmlHelpers.RenderStockPercentCell(Model.ReportData.Total.HeadlineStock, Model.ReportData.Total.HeadlineStock )
                    </tr>
                </tfoot>
            }
            else
            {
                <tbody>
                    <tr>
                        <td id="no-data-row" colspan="11"
                            data-isNoInfo="true"
                            align="center">
                            No Information Is Available
                        </td>
                    </tr>
                </tbody>
            }
        </table>
    </div>
</div>
<form id="internal-login-form" method="get" action="@Model.InternalLoginAction" target="_blank">
    <input type="hidden" id="custId" name="custId" value="" />
    <input type="hidden" id="custName" name="custName" value="" />
    <input type="hidden" id="roleId" name="roleId" value="" />
</form>
@section Scripts{
    @StaticResources.RenderScripts("~/assets/report/bundles/housewinloss")
    <script>
        var betTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReportFilterViewModel.AllBetTypesSelectionViewModel.Items.GroupBy(i => i.SportTypeGroup)));
    </script>
}
@helper RenderDatePicker()
{
    <div class="form-group from-date-box" style="display:@(Model.Query.IsHistoricReport==1?"none":"inline-block")">
        <label>Date</label>
        <div class="control date">
            <div id="date-container"
                 class="input-group date fromdate"
                 data-mindate="@Model.ReportFilterViewModel.DatePickerViewModel.MinDate.ToShortDate()"
                 data-maxdate="@Model.ReportFilterViewModel.DatePickerViewModel.MaxDate.ToShortDate()"
                 data-currentdate="@Model.ReportFilterViewModel.DatePickerViewModel.CurrentDate.ToShortDate()">
                <input type="text"
                       id="date"
                       name="Date"
                       readonly="readonly"
                       autocomplete="off"
                       class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                       value="@Model.ReportFilterViewModel.DatePickerViewModel.CurrentDate.ToShortDate()" />
                <span class="input-group-addon">
                    <span class="icon-calendar" id="fdate_trigger"></span>
                </span>
            </div>
        </div>
    </div>
}
