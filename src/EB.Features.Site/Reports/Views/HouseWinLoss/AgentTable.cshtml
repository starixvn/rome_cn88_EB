@using EB.Features.Shared.Model;
@using EB.Features.Site.Reports.ViewModel.HouseWinLoss
@using EB.Features.Reports.Resources

@model HouseWinLossReportViewModel
@{
    var colIndex = 0;
}
<div class="tab-content main-content" id="tab-main-content">
    <table class="tbl-noborder tbl-report settlement-report" id="tbl-report"
           data-sortedcolumn="UserName"
           data-descendingsort="False"
           data-totalrecords="@Model.ReportData.Matches.Count()">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th class="text-left header sorting" data-colindex="@(colIndex++)" data-sortedname="UserName"><span class="sorting-item">@ReportResources.AgentUserName</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Wagers"><span class="sorting-item">@ReportResources.Wagers</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Stake"><span class="sorting-item">@ReportResources.Stake</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="ValidStake"><span class="sorting-item">@ReportResources.ValidStake</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MemberIncome"><span class="sorting-item">@ReportResources.MemberIncome</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="Agent"><span class="sorting-item">@ReportResources.Agent</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentResult"><span class="sorting-item">@ReportResources.AgentResult</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="MAResult"><span class="sorting-item">@ReportResources.MAResult</span></th>
                <th class="text-right header sorting" data-colindex="@(colIndex++)" data-sortedname="AgentStock"><span class="sorting-item">@ReportResources.AgentStock</span></th>
            </tr>
        </thead>

        @if (Model.ReportData.Matches.Any())
        {
            <tbody>
                @foreach (var row in Model.ReportData.Matches)
                {
                <tr>
                    <td class="text-left">
                        <a class="downline-link" href="@Model.GetDownlineLink(row.CustId, row.UserName, UserLevel.Member.Value, Model.Query.HeadlineId)"> @row.UserName </a>
                    </td>
                    @HtmlHelpers.RenderWagerCell(row.Wagers)
                    @HtmlHelpers.RenderNumberCell(row.Stake)
                    @HtmlHelpers.RenderNumberCell(row.ValidStake)
                    @HtmlHelpers.RenderNumberCell(row.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(row.Agent)
                    @HtmlHelpers.RenderNumberCell(row.AgentResult)
                    @HtmlHelpers.RenderNumberCell(row.MasterResult)
                    @HtmlHelpers.RenderNumberCell(row.AgentStock)
                </tr>
                }
            </tbody>
        }


        @if (Model.ReportData.IsShowTotalRow)
        {
            <tfoot>
                <tr class="total">
                    <th class="text-left header">@ReportResources.Total</th>
                    @HtmlHelpers.RenderWagerCell(Model.ReportData.Total.Wagers)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.Stake)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.ValidStake)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.MemberIncome)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.Agent)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.AgentResult)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.MasterResult)
                    @HtmlHelpers.RenderNumberCell(Model.ReportData.Total.AgentStock)
                </tr>
            </tfoot>
        }
        else
        {
            <tbody>
                <tr>
                    <td id="no-data-row" colspan="9"
                        data-isNoInfo="true"
                        align="center">
                        @AppResources.NoInformationIsAvailable
                    </td>
                </tr>
            </tbody>
        }
    </table>
</div>