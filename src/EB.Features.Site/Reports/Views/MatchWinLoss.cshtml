@using EB.Features.Reports.Extension;
@using EB.Features.Reports.Model;
@using EB.Features.Reports;

@model MatchWinLossReportViewModel
@{
    Layout = "~/Shared/Views/_Layout.cshtml";
    ViewBag.Title = ReportResources.MatchWinLossReportTitle;
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/report/bundles/reports")
}

<div class="report-detail wager-report">
    <div class="page-title title-report-detail">
        <ul class="nav nav-tabs" role="tablist">
            <li class="report-name">@ViewBag.Title</li>
        </ul>
        <div class="breadcrumb-container">
            <span id="icon-excel" class="icon-excel" title="@AppResources.ExportToExcel" data-toggle="tooltip" data-placement="bottom"></span>
        </div>
    </div>

    <form class="form-inline filter report-form" role="form" id="report-form">
        @SportGroupSelection.Render(Model.ReportFilterViewModel.SportGroupSelectionViewModel, true)
        @DatePicker.Render(Model.ReportFilterViewModel.DatePickerViewModel)
        @BetTypeSelection.Render(Model.ReportFilterViewModel.BetTypeSelectionViewModel, true)
        @LiveStatusSelection.Render(Model.ReportFilterViewModel.LiveStatusSelectionViewModel, true)
        <div class="form-group">
            <label class="isTest">
                @Html.CheckBox("IsTest", Model.ReportFilterViewModel.IsTest)
                @SiteResources.ExcludeTestData
            </label>
        </div>
        <div class="form-group">
            <input type="submit" value="@AppResources.Submit" class="btn-submit" />
        </div>
    </form>

    <form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("ExportMatchWinLoss","Reports")">
        @Html.Hidden("Date", Model.Query.Date)
        @Html.Hidden("UserSelectedSportGroupId", Model.Query.UserSelectedSportGroupId)
        @Html.Hidden("UserSelectedBetTypeId", Model.Query.UserSelectedBetTypeId)
        @Html.Hidden("UserSelectedLiveStatusId", Model.Query.UserSelectedLiveStatusId)
        @Html.Hidden("IsTest", Model.ReportFilterViewModel.IsTest)
    </form>

    <div class="tab-content main-content" id="tab-main-content">
        <table class="tbl-noborder tbl-report settlement-report" id="tbl-report">
            <thead class="tableFloatingHeaderOriginal">
                <tr>
                    <th class="text-left header bettype">@ReportResources.BetType</th>
                    <th class="text-right header">@ReportResources.Wagers</th>
                    <th class="text-right header">@ReportResources.Stake</th>
                    <th class="text-right header">@ReportResources.ValidStake</th>
                    <th class="text-right header">@ReportResources.MemberIncome</th>
                    <th class="text-right header">@ReportResources.HouseIncome</th>
                    <th class="text-right header">@ReportResources.HeadlineStock</th>
                    <th class="text-right header">@ReportResources.HeadlineStockPercent</th>
                </tr>
                @if (Model.ReportData.IsShowTotalRow)
                {
                    <tr class="total">
                        <th class="text-left header">@ReportResources.GrandTotal</th>
                        @HtmlHelpers.RenderHeaderWagerCell(Model.ReportData.Total.Wagers)
                        @HtmlHelpers.RenderHeaderNumberCell(Model.ReportData.Total.Stake)
                        @HtmlHelpers.RenderHeaderNumberCell(Model.ReportData.Total.ValidStake)
                        @HtmlHelpers.RenderHeaderNumberCell(Model.ReportData.Total.MemberIncome)
                        @HtmlHelpers.RenderHeaderNumberCell(Model.ReportData.Total.HouseIncome)
                        @HtmlHelpers.RenderHeaderNumberCell(Model.ReportData.Total.HeadlineStock)
                        @HtmlHelpers.RenderHeaderPercentCell(Model.TotalHeadlineStockPercent, "", true)
                    </tr>
                }
            </thead>
            @foreach (var row in Model.ReportData.NormalMatches.GroupBy(i => $"{i.LeagueId}_{i.MatchId}"))
            {
                var firstRowOfGroup = row.ToList();
                var matchId = firstRowOfGroup.First().MatchId;
                var leagueId = firstRowOfGroup.First().LeagueId;
                var subTotal = firstRowOfGroup.Sum();

                <tr class="match-title-row">
                    <td class="text-left col-username" colspan="8">
                        <span class="league-title" title="@firstRowOfGroup.First().LeagueName">@firstRowOfGroup.First().LeagueName</span>
                        @if (!string.IsNullOrWhiteSpace(firstRowOfGroup.First().EventInfo))
                        {
                            <span class="match-title">@firstRowOfGroup.First().EventInfo</span>
                        }
                    </td>
                </tr>

                foreach (var betType in Model.ReportData.NormalMatchesHasMajorBetType.Where(m => m.MatchId == matchId))
                {
                    <tr>
                        <td class="text-left">@betType.BetTypeGroupName</td>
                        @RenderRow(betType)

                        @HtmlHelpers.RenderStockPercentCell(betType.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                    </tr>
                }

                if (Model.ReportData.NormalMatchesHasMinorBetType.Any(m => m.MatchId == matchId)
                    || Model.ReportData.NormalMatchesHasOutright.Any(m => m.LeagueId == leagueId))
                {
                    var minorMatches = Model.ReportData.NormalMatchesHasMinorBetType.Where(m => m.MatchId == matchId);
                    var outrightMatches = Model.ReportData.NormalMatchesHasOutright.Where(m => m.LeagueId == leagueId);
                    var otherGroup = minorMatches.Concat(outrightMatches).Sum();
                    <tr class="group" data-leagueid="@($"{leagueId}_{matchId}")">
                        <td class="col-event-span-desktop text-left">
                            <span class="group-name-wrapper">
                                <span class="icon-chevron-right"></span>
                                <span class="group-name">@AppResources.Others</span>
                            </span>
                        </td>
                        @RenderRow(otherGroup)

                        @HtmlHelpers.RenderStockPercentCell(otherGroup.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                    </tr>

                    foreach (var betType in Model.ReportData.NormalMatchesHasMinorBetType.Where(m => m.MatchId == matchId))
                    {
                        <tr class="childrow-@($"{leagueId}_{matchId}") hide">
                            <td class="text-left child">@betType.BetTypeGroupName</td>
                            @RenderRow(betType)

                            @HtmlHelpers.RenderStockPercentCell(betType.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                        </tr>
                    }

                    foreach (var betType in Model.ReportData.NormalMatchesHasOutright.Where(m => m.LeagueId == leagueId))
                    {
                        <tr class="childrow-@($"{leagueId}_{matchId}") hide">
                            <td class="text-left child">@betType.BetTypeGroupName</td>
                            @RenderRow(betType)

                            @HtmlHelpers.RenderStockPercentCell(betType.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                        </tr>
                    }
                }

                <tr class="sub-total-row">
                    <td class="text-left">@ReportResources.SubTotal</td>
                    @RenderRow(subTotal)

                    @HtmlHelpers.RenderStockPercentCell(subTotal.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                </tr>
            }

            @if (Model.ReportData.Parlay != null)
            {
                <tr class="match-title-row">
                    <td class="text-left col-username" colspan="8">
                        <span class="league-title" title="@Model.ReportData.Parlay.LeagueName">@Model.ReportData.Parlay.LeagueName</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-left">@Model.ReportData.Parlay.BetTypeGroupName</td>
                    @RenderRow(Model.ReportData.Parlay)

                    @HtmlHelpers.RenderStockPercentCell(Model.ReportData.Parlay.HeadlineStock, Model.ReportData.Total.HeadlineStock)
                </tr>
            }

            @if (Model.ReportData.IsShowTotalRow)
            {
                <tfoot>
                    <tr class="total">
                        <td class="text-left">@ReportResources.GrandTotal</td>
                        @RenderRow(Model.ReportData.Total)
                        @HtmlHelpers.RenderStockPercentCell(Model.TotalHeadlineStockPercent, Model.TotalHeadlineStockPercent)
                    </tr>
                </tfoot>
            }
            else
            {
                <tbody>
                    <tr>
                        <td id="no-data-row" colspan="8"
                            data-isNoInfo="true"
                            align="center">
                            @AppResources.NoInformationIsAvailable
                        </td>
                    </tr>
                </tbody>
            }
        </table>
    </div>
</div>

@section Scripts{
    @StaticResources.RenderScripts("~/assets/report/bundles/matchwinloss")
    <script>
        var betTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ReportFilterViewModel.AllBetTypesSelectionViewModel.Items.GroupBy(i => i.SportTypeGroup)));
    </script>
}

@helper RenderRow(MatchWinLossModel row)
{
    @HtmlHelpers.RenderWagerCell(row.Wagers)
    @HtmlHelpers.RenderNumberCell(row.Stake)
    @HtmlHelpers.RenderNumberCell(row.ValidStake)
    @HtmlHelpers.RenderNumberCell(row.MemberIncome)
    @HtmlHelpers.RenderNumberCell(row.HouseIncome)
    @HtmlHelpers.RenderNumberCell(row.HeadlineStock)
}